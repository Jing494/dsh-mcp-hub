{
  "name": "dsh-mcp-hub",
  "version": "0.2.1",
  "type": "module",
  "description": "Remote MCP servers for DeepSeek Harness: a settings page, connection management, and mcp__<server>__<tool> registration in one plugin",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "sse",
    "streamable-http"
  ],
  "homepage": "https://github.com/Jing494/dsh-mcp-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jing494/dsh-mcp-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Jing494/dsh-mcp-hub/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "runtime": "host"
  }
}
